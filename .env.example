NODE_ENV=development
WECHATY_PUPPET_SERVICE_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
POSTGRES_DB=wechaty
POSTGRES_USER=wechaty
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://wechaty:change-me@postgres:5432/wechaty
REDIS_URL=redis://redis:6379
ADMIN_CONTACT_IDS=
KNOWLEDGE_FILE=/app/knowledge/knowledge.txt
MEMORY_RETENTION_DAYS=30
MESSAGE_RATE_LIMIT=20
MESSAGE_RATE_WINDOW_SECONDS=60
RAG_TOP_K=5
RAG_MIN_SCORE=0.75
RAG_MAX_CHARS=6000
LLM_GLOBAL_CONCURRENCY=4
LLM_PER_USER_CONCURRENCY=1
